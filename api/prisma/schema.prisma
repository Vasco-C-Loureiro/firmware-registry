generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReleaseState {
  DRAFT
  TESTING
  RELEASED
  DEPRECATED
}

enum AuditAction {
  UPLOADED
  STATE_CHANGED
  DOWNLOADED
}

model Product {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  variants    Variant[]
}

model Variant {
  id          String          @id @default(cuid())
  product     Product         @relation(fields: [productId], references: [id])
  productId   String
  name        String
  code        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  firmware    FirmwareImage[]
}

model FirmwareImage {
  id             String       @id @default(cuid())
  variant        Variant      @relation(fields: [variantId], references: [id])
  variantId      String
  version        String
  fileName       String
  storagePath    String
  fileSizeBytes  Int
  checksumSha256 String
  state          ReleaseState @default(DRAFT)
  uploadedBy     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditEvents    AuditEvent[]

  @@unique([variantId, version])
}

model AuditEvent {
  id              String         @id @default(cuid())
  firmwareImage   FirmwareImage? @relation(fields: [firmwareImageId], references: [id])
  firmwareImageId String?
  action          AuditAction
  fromState       ReleaseState?
  toState         ReleaseState?
  actor           String
  detail          String?
  timestamp       DateTime       @default(now())
}
